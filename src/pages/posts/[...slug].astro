---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// 要点は markdown で書けるようにする（箇条書き・強調が要るため）
const notesHtml = post.data.notes ? marked.parse(post.data.notes) : null;

// 要約も markdown で描画する。強調が要るのは要点と同じで、
// 生テキストで出すとサマリー内の ** がそのまま読者に見えてしまうため。
// front matter の `>-`（折り畳みスカラ）は段落の切れ目を単一の \n に畳むので、
// \n\n に開き直してから marked に渡し、段落として解釈させる。
const summaryHtml = marked.parse(
  post.data.summary
    .split('\n')
    .map((para) => para.trim())
    .filter(Boolean)
    .join('\n\n')
);

// meta と RSS には HTML を入れられないので、強調記号を落とした平文を使う。
const summaryText = post.data.summary.replace(/\*\*/g, '');

// 本文が発言ごとの枠（<div class="turn user|claude">）で書かれた記事は、会話の見た目で出す。
// エッセイ形式の記事（対話ログではないもの）は枠がないので、普通の本文として出す。
const isChat = post.body.includes('<div class="turn ');

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
---

<Base title={post.data.title} description={summaryText}>
  <article>
    <div class="post-header">
      <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)} 時点</time>
      <h1>{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}
        </div>
      )}
    </div>

    {/* 要約＝何の話だったか。一覧・RSS・検索結果の説明文と同じ文。畳まずに冒頭に出す。
        長い対話ほど要約も長くなるので、段落に分けて描画する。 */}
    {/* 要約と要点は「記事について」の枠にまとめる。地の文で書くと、後に続く Claude の応答と見分けがつかないため。 */}
    <section class="abstract">
      <p class="abstract-label">要約</p>
      <div class="lead" set:html={summaryHtml} />

      {/* 要点＝何が分かったか。読み返す本人向けなので、畳んでおいて必要なときに開く。 */}
      {notesHtml && (
        <details class="digest">
          <summary>要点を開く</summary>
          <div class="digest-inner notes-body" set:html={notesHtml} />
        </details>
      )}
    </section>

    {/* 対話の記事は本文が発言ごとの枠（turn）で書かれていて、会話の見た目で出す。 */}
    <div class={isChat ? 'post-body chat' : 'post-body essay'}>
      <Content />
    </div>

    <a class="back-link" href="/">← 一覧へ</a>
  </article>
</Base>
