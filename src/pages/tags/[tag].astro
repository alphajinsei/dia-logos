---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
---

<Base title={`#${tag}`}>
  <h1 style="font-size:22px">#{tag}</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <h2><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h2>
        <p>{post.data.summary}</p>
      </li>
    ))}
  </ul>
  <a class="back-link" href="/">← 一覧へ</a>
</Base>
