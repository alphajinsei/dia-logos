---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// 要点は markdown で書けるようにする（箇条書き・強調が要るため）
const notesHtml = post.data.notes ? marked.parse(post.data.notes) : null;

// 要約も markdown で描画する。強調が要るのは要点と同じで、
// 生テキストで出すとサマリー内の ** がそのまま読者に見えてしまうため。
// front matter の `>-`（折り畳みスカラ）は段落の切れ目を単一の \n に畳むので、
// \n\n に開き直してから marked に渡し、段落として解釈させる。
const summaryHtml = marked.parse(
  post.data.summary
    .split('\n')
    .map((para) => para.trim())
    .filter(Boolean)
    .join('\n\n')
);

// meta と RSS には HTML を入れられないので、強調記号を落とした平文を使う。
const summaryText = post.data.summary.replace(/\*\*/g, '');

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
---

<Base title={post.data.title} description={summaryText}>
  <article>
    <div class="post-header">
      <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)} 時点</time>
      <h1>{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}
        </div>
      )}
    </div>

    {/* サマリー＝結論。これ単体で読めて、同時に下の軌跡への目次になる。
        長い対話ほど要約も長くなるので段落に分けて描画する。 */}
    <section class="summary">
      <p class="summary-label">要約</p>
      <div class="summary-body" set:html={summaryHtml} />
    </section>

    {/* 要点＝内容の結晶。サマリー(索引)と軌跡(過程)の中間。
        「何が分かったか」を構造として持ち帰れるようにする層。 */}
    {notesHtml && (
      <section class="notes">
        <p class="notes-label">要点</p>
        <div class="notes-body" set:html={notesHtml} />
      </section>
    )}

    <p class="trajectory-label">軌跡（対話そのまま）</p>
    <div class="post-body">
      <Content />
    </div>

    <a class="back-link" href="/">← 一覧へ</a>
  </article>
</Base>
